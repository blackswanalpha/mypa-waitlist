# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
/build
next-env.d.ts

# production
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets)
.env
.env.local
.env*.local
# A timestamped backup dodges every rule above: `.env*.local` does not match
# `.env.local.bak.1787152611`, and one of those was sitting untracked in this
# tree with a live CONVEX_SELF_HOSTED_ADMIN_KEY in it.
.env*.bak*

# convex (generated; recreated by `convex dev` / `convex deploy`)
.convex/
# convex/_generated/ is committed: Coolify's Docker build uses it as-is
# instead of running `convex codegen` with a production deploy key.
# Regenerate with `npx convex dev` (or `npx convex codegen`) and commit it
# with any change under convex/.

# typescript
*.tsbuildinfo

# vercel
.vercel

# carousel source PNGs; the page serves the WebP exports beside them
public/carousel/*.png

# playwright
/test-results/
/playwright-report/

# Admin logins and passwords (see admin.md). Never commit.
admin.md
